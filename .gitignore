# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Environments
.env
.venv
env/
venv/
ENV/

# Runtime Uploads & Artifacts
uploads/*
!uploads/.gitkeep
artifacts/*
!artifacts/.gitkeep
data/*.db
data/*.sqlite*

# Large Model Weights and Checkpoints
**/checkpoints/
**/weights/
*.safetensors
*.bin
*.pt
*.pth
*.onnx
*.gguf

# Notebooks & Logs
.ipynb_checkpoints
*.log

# OS & Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Whitelist fine-tuned Agent 1 LoRA model (< 100MB for Kaggle deployment)
!weights/
!weights/agent1_router/
!weights/agent1_router/*

# Whitelist fine-tuned Agent 1 LoRA model in main/weights
!main/weights/
!main/weights/agent1_router/
!main/weights/agent1_router/*

# Runtime Uploads & Artifacts in main
main/uploads/*
!main/uploads/.gitkeep
main/artifacts/*
!main/artifacts/.gitkeep
main/data/*.db
main/data/*.sqlite*
