# =====================================================================
# MULTI-AGENT RESEARCH RAG SYSTEM CONFIGURATION
# =====================================================================

# 1. Chế độ thực thi (EXECUTION_MODE):
#    - "local_api": Chạy trên laptop (ThinkBook G8+), gọi API Gemini / DeepSeek + CPU search.
#    - "kaggle_gpu": Chuyển tiếp toàn bộ suy luận nặng sang Kaggle Dual T4 Worker.
EXECUTION_MODE=local_api

# 2. Cấu hình khi chạy qua Kaggle Worker (EXECUTION_MODE=kaggle_gpu):
#    Dán URL công khai sinh ra từ notebook run_dual_t4_serving.ipynb tại đây:
REMOTE_INFERENCE_URL=https://your-ngrok-or-cloudflare-subdomain.ngrok-free.app

# 3. Khóa API cho Cloud Foundation LLM (Dùng khi chạy EXECUTION_MODE=local_api):
#    - Miễn phí: Lấy tại https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

#    - Dự phòng: DeepSeek hoặc OpenAI
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# 4. Mô hình mặc định
DEFAULT_LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=BAAI/bge-m3

# 5. Ngưỡng giới hạn StateGraph
MAX_ORCHESTRATOR_RETRY=3
DEFAULT_MAX_INTERNAL_RETRY=2
MAX_FACTCHECK_CALLS=120
TOP_K_RERANK=5
